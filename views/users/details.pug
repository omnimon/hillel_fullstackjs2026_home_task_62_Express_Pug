doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/styles.css')
  body
    main.container
      nav.navigation
        a(href='/users') Users
        a(href='/articles') Articles
      section.card
        p.eyebrow PUG template
        h1= user.name
        dl.details
          div
            dt ID
            dd= user.id
          div
            dt Email
            dd= user.email
          div
            dt Role
            dd= user.role
        a.button.secondary(href='/users') Back to users
